// Prisma schema for the CRM module.
// See DECISIONS.md for the data-modelling rationale (single-table client model,
// pipeline stages, stagnation tracking).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the musl target covers the Alpine-based container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Whether a client is a company or an individual.
enum ClientType {
  COMPANY
  INDIVIDUAL
}

/// Stages an opportunity moves through in the sales pipeline.
/// WON and LOST are terminal stages.
enum PipelineStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// An application user who can sign in to the CRM. Authentication only (no
/// per-user data ownership in this scope); see DECISIONS.md.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A client is either a company or an individual (discriminated by `type`).
/// Type-specific fields are nullable at the DB level and enforced per-type in
/// the API DTOs (see DECISIONS.md).
model Client {
  id   String     @id @default(cuid())
  type ClientType

  // Shared contact fields
  email String
  phone String?
  notes String?

  // Company-specific
  companyName        String?
  registrationNumber String? // e.g. SIRET / company registration number
  industry           String?

  // Individual-specific
  firstName String?
  lastName  String?

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

/// A sales opportunity linked to a client.
model Opportunity {
  id                String        @id @default(cuid())
  title             String
  amount            Decimal       @db.Decimal(12, 2)
  expectedCloseDate DateTime      @db.Date
  stage             PipelineStage @default(NEW)

  // Updated whenever `stage` changes; used to detect stagnant opportunities.
  stageChangedAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([stage])
  @@index([expectedCloseDate])
}
