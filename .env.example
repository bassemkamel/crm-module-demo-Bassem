# ---- PostgreSQL ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5432

# Adminer web UI for inspecting the database.
ADMINER_PORT=81

# ---- Backend (NestJS) ----
# Used by Prisma to connect to the database.
# When running the backend inside Docker, host is the compose service name "db".
# For local (non-Docker) dev, use localhost.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
BACKEND_PORT=3001

# Number of days without a stage change before an opportunity is "stagnant".
STAGNANT_THRESHOLD_DAYS=14

# ---- Frontend (Next.js) ----
# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_PORT=3000
